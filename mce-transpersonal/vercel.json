{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/_opt/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/servicios",
      "destination": "/formaciones",
      "permanent": true
    },
    {
      "source": "/inteligencia-emocional-transpersonal",
      "destination": "/formaciones",
      "permanent": true
    },
    {
      "source": "/otros-cursos-y-charlas",
      "destination": "/formaciones",
      "permanent": true
    },
    {
      "source": "/monografico-transpersonal",
      "destination": "/formaciones",
      "permanent": true
    },
    {
      "source": "/eventos",
      "destination": "/formaciones",
      "permanent": true
    },
    {
      "source": "/eventos-2",
      "destination": "/formaciones",
      "permanent": true
    },
    {
      "source": "/iii-congreso-transpersonal-mce",
      "destination": "/formaciones",
      "permanent": true
    },
    {
      "source": "/inscripcion-iii-congreso-transpersonal-mce",
      "destination": "/formaciones",
      "permanent": true
    },
    {
      "source": "/escuelas-mce",
      "destination": "/sedes",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/2016/:ruta*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/:ruta*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/author/:ruta*",
      "destination": "/",
      "permanent": true
    }
  ]
}
